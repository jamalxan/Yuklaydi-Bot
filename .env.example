# Telegram
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
LOCAL_API_URL=http://telegram-bot-api:8081

# Database
# docker compose builds DATABASE_URL itself from POSTGRES_PASSWORD (required in prod)
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://bot:change_me@postgres:5432/yuklaydi_bot
# Per-process SQLAlchemy pool (route through PgBouncer when scaling out)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=512
# Optional locally, REQUIRED in prod; injected into REDIS_URL automatically
REDIS_PASSWORD=

# Genius API (get at genius.com/api-clients)
GENIUS_TOKEN=your_genius_token_here

# Musixmatch API (optional, fallback for Uzbek/non-English lyrics; get at developer.musixmatch.com)
MUSIXMATCH_TOKEN=

# Bot config
ADMIN_IDS=123456789,987654321
DEFAULT_LANG=uz
# Largest file the bot sends. Above 50 MB requires LOCAL_API_URL (the
# self-hosted Bot API in docker-compose, max 2000); without it the cloud API
# caps uploads at 50 MB and the bot clamps this value to 50 automatically.
MAX_FILE_MB=500
# Videos bigger than one upload are NOT downgraded: they are cut without
# re-encoding (same quality) into upload-sized parts, sent one after another.
SPLIT_LARGE_VIDEOS=true
MAX_VIDEO_MB=500               # largest video downloaded in total
MAX_AUDIO_DURATION=1200        # longest track (seconds) for MP3 / music downloads
STATS_TZ=Asia/Tashkent         # "today" boundary for admin statistics
DOWNLOAD_DIR=/downloads

# Cookies for yt-dlp.
# Instagram REQUIRES login cookies (anonymous access is blocked platform-wide).
# Export cookies.txt with a browser extension ("Get cookies.txt LOCALLY") while
# logged in to instagram.com (+ youtube.com helps dodge bot-checks), then either:
#   put it at ./secrets/cookies.txt (mounted read-only at /app/secrets),
#   which is the default lookup path when COOKIES_FILE is empty.
#   Never store it under DOWNLOAD_DIR — that volume is shared and swept.
# or read them straight from a local browser profile (dev only, browser must be closed):
#   COOKIES_FROM_BROWSER=chrome
COOKIES_FILE=/app/secrets/cookies.txt
COOKIES_FROM_BROWSER=

# Scale / fairness
WORKER_CONCURRENCY=20          # arq jobs per worker process (mostly I/O-bound)
YT_DLP_WORKER_CONCURRENCY=4    # concurrent yt-dlp downloads per worker process
PER_USER_DOWNLOAD_CAP=3        # simultaneous fresh downloads per user
JOB_TIMEOUT=900                # arq job hard timeout, seconds (>= 300 + (MAX_FILE_MB - 50))
SEARCH_EXECUTOR_WORKERS=4      # threads for music search (bounded pool)
MAX_QUEUE_DEPTH=100000         # backpressure: reject new jobs above this depth

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
CALLBACK_RATE_LIMIT_REQUESTS=30  # button presses per RATE_LIMIT_WINDOW
CALLBACK_DEBOUNCE_SECONDS=3      # identical button press ignored within N s

# Logging
LOG_LEVEL=INFO

# Optional AudD.io key (paid): fallback recogniser when Shazam finds nothing.
# Empty = disabled, no requests are made.
AUDD_TOKEN=
