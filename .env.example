# Telegram
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
LOCAL_API_URL=http://telegram-bot-api:8081

# Database
DATABASE_URL=postgresql+asyncpg://bot:bot_password@postgres:5432/yuklaydi_bot
# Per-process SQLAlchemy pool (route through PgBouncer when scaling out)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=512

# Genius API (get at genius.com/api-clients)
GENIUS_TOKEN=your_genius_token_here

# Musixmatch API (optional, fallback for Uzbek/non-English lyrics; get at developer.musixmatch.com)
MUSIXMATCH_TOKEN=

# Bot config
ADMIN_IDS=123456789,987654321
DEFAULT_LANG=uz
MAX_FILE_MB=2000
DOWNLOAD_DIR=/downloads

# Cookies for yt-dlp.
# Instagram REQUIRES login cookies (anonymous access is blocked platform-wide).
# Export cookies.txt with a browser extension ("Get cookies.txt LOCALLY") while
# logged in to instagram.com (+ youtube.com helps dodge bot-checks), then either:
#   COOKIES_FILE=/downloads/cookies.txt   (default lookup path if empty)
# or read them straight from a local browser profile (dev only, browser must be closed):
#   COOKIES_FROM_BROWSER=chrome
COOKIES_FILE=
COOKIES_FROM_BROWSER=

# Scale / fairness
WORKER_CONCURRENCY=20          # arq jobs per worker process (mostly I/O-bound)
YT_DLP_WORKER_CONCURRENCY=4    # concurrent yt-dlp downloads per worker process
PER_USER_DOWNLOAD_CAP=3        # simultaneous fresh downloads per user
JOB_TIMEOUT=300                # arq job hard timeout, seconds
SINGLE_FLIGHT_WAIT=60          # max wait for a duplicate URL already downloading
MAX_QUEUE_DEPTH=100000         # backpressure: reject new jobs above this depth

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
